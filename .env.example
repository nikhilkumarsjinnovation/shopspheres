# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (Server-only, bypasses RLS for trusted admin routines)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upstash Redis (Phase 1.4). Until these are set, AI rate limits use an in-memory window in the dev server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret for the ai_user_profiles cache webhook (Phase 1.4). Do not commit a real value.
SUPABASE_WEBHOOK_SECRET=

# Phase 2. Vercel cron sends Authorization: Bearer $CRON_SECRET to /api/v1/ai/proactive
CRON_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Stripe test secret (sk_test_...). Bank details are not required for sandbox charges.
STRIPE_SECRET_KEY=

