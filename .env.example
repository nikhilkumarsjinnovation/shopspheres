# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (Server-only, bypasses RLS for trusted admin routines)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upstash Redis (Phase 1.4). Until these are set, AI rate limits use an in-memory window in the dev server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional names read by @upstash/redis Redis.fromEnv() when the UPSTASH_* pair is unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Shared secret for the ai_user_profiles cache webhook (Phase 1.4). Do not commit a real value.
SUPABASE_WEBHOOK_SECRET=

# Phase 2. Vercel cron sends Authorization: Bearer $CRON_SECRET to /api/v1/ai/proactive
CRON_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Stripe test secret (sk_test_...). Bank details are not required for sandbox charges.
STRIPE_SECRET_KEY=

# Stripe test webhook signing secret (whsec_...). From `stripe listen` or the Dashboard endpoint.
STRIPE_WEBHOOK_SECRET=

# HubSpot private app token. Scopes: crm.objects.contacts.read, crm.objects.contacts.write.
HUBSPOT_PRIVATE_APP_TOKEN=

# Resend. Free tier sends from onboarding@resend.dev to the account email until a domain is verified.
# Without a domain, all mail is redirected to RESEND_SANDBOX_TO (hackathon-safe).
RESEND_API_KEY=
RESEND_FROM_EMAIL=ShopSphere <onboarding@resend.dev>
RESEND_SANDBOX_TO=nikhil.kumar@sjinnovation.com
# Optional: set to 1 to exercise live DB campaign paths in scripts/test_a3_campaigns.ts
CAMPAIGN_LIVE=

# Optional: set to 1 to train from live orders and UPDATE ml_models in scripts/test_a3_churn.ts
A3_CHURN_LIVE=

# NVIDIA NIM Embeddings Fallback
NVIDIA_API_KEY=
EMBED_NVIDIA_MODEL=nemotron-3-embed-1b


